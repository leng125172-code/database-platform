# Shared deployment settings. Copy to .env on the server and keep mode 0600.
COMPOSE_PROJECT_PREFIX=dcfs
BIND_IP=192.168.100.13
TZ=Asia/Shanghai
NVME_DATA_ROOT=/dataNvme/DockerData
HDD_DATA_ROOT=/data/DockerData
BACKUP_RETENTION_DAYS=14

# Immutable image references captured on 2026-10-08.
MSSQL_IMAGE=1jlddiirq5at1e3bd0-mcr.xuanyuan.run/mssql/server:2025-CU9-ubuntu-24.04@sha256:2b5b581621126574f3d1f75e78d3eebe8d05aedb59ad0cfdf9aa42cb0634d726
POSTGRES_IMAGE=postgres:18.6-trixie@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336
MARIADB_IMAGE=mariadb:11.8.9-noble@sha256:6422478cb8e159f080fb1d8ccf65101e26fe51385787fde7d16c3b165a331f15
MONGODB_IMAGE=mongo:9.0.2-noble@sha256:61dd87ff554dc20386c63ebe1f7ede27314370ad5a7bf357c685fab424672158
VALKEY_IMAGE=valkey/valkey:9.0.6-alpine3.24@sha256:187679e3bd4036959631e3f03983ab2ba503ab21e6fd0454d508e909db2ee989

# Host ports are bound only to BIND_IP, not 0.0.0.0.
MSSQL_PORT=1433
POSTGRES_PORT=5432
MARIADB_PORT=3306
MONGODB_PORT=27017
VALKEY_PORT=6379

# SQL Server Developer is for development/test only. Replace with a licensed PID for production.
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=<generate-a-strong-password>
MSSQL_MEMORY_LIMIT_MB=24576
MSSQL_CPU_LIMIT=8
MSSQL_MEMORY_LIMIT=28g

POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_CPU_LIMIT=8
POSTGRES_MEMORY_LIMIT=32g

MARIADB_ROOT_PASSWORD=<generate-a-strong-password>
MARIADB_CPU_LIMIT=6
MARIADB_MEMORY_LIMIT=16g

MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=<generate-a-strong-password>
MONGODB_CPU_LIMIT=6
MONGODB_MEMORY_LIMIT=16g

VALKEY_PASSWORD=<generate-a-strong-password>
VALKEY_CPU_LIMIT=4
VALKEY_MEMORY_LIMIT=6g
VALKEY_MAXMEMORY=4gb
