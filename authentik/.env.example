# Authentik runtime settings and its dedicated PostgreSQL credentials.
# The Authentik image reference belongs in the repository root .images.env.
AUTHENTIK_SECRET_KEY=<generate-a-long-random-secret>
AUTHENTIK_DATA_ROOT=/data/DockerData/authentik
AUTHENTIK_SERVER_CPU_LIMIT=2
AUTHENTIK_SERVER_MEMORY_LIMIT=2g
AUTHENTIK_WORKER_CPU_LIMIT=2
AUTHENTIK_WORKER_MEMORY_LIMIT=2g
BACKUP_RETENTION_DAYS=14

AUTHENTIK_POSTGRESQL__HOST=postgres
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=<generate-a-strong-password>
AUTHENTIK_POSTGRESQL__SSLMODE=disable
